# --- Supabase Auth (browser + server SSR clients) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the new "publishable" key (not the legacy "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- Database (Drizzle + postgres-js) ---
# App runtime: Supavisor TRANSACTION pooler (port 6543, *.pooler.supabase.com).
# IPv4-reachable + short-lived pooled connections — required for serverless.
# Driver runs with { prepare: false } because of the transaction pooler.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Migrations only (drizzle-kit generate/migrate): SESSION pooler (port 5432).
# Never point migrations at the transaction pooler.
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- App ---
# Absolute site URL — used for metadataBase, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: SUPABASE_SERVICE_ROLE_KEY is intentionally NOT used by this app. All
# privileged data access goes through DATABASE_URL server-side, so the
# service_role key would only add leak surface. Do not add it back.
